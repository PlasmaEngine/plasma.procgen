// plasma.procgen — Procedural Generation.
//
// The AUTHORED manifest, kept in source next to the plugin. Component hashes and sizes are NOT
// here: the packaging step computes those and emits them into the published manifest.
//
// Field reference and validation rules: Docs/PluginPackageManagerPlan.html §05.

PackageInfo
{
	string %Id{"plasma.procgen"}
	string %Version{"1.3.0"}
	string %Publisher{"PlasmaTechnology"}
	string %License{"MIT"}
	string %Homepage{"https://plasmagameengine.com"}

	string %MinEngineVersion{"0.12.0"}
	string %MaxEngineVersion{"0.12.0"}
	string %AbiTag{"win64-msvc19-0.12.0-abi7-dev"}

	string %DisplayName{"Procedural Generation"}
	string %Category{"Rendering"}
	string %Description{"Adds support for placing objects procedurally."}
	string %Icon{"Branding/ProcGenIcon.png"}
	string %Banner{"Branding/ProcGenBanner.png"}

	string %EditorPlugins{"plEditorPluginProcGen"}
	string %EditorEnginePlugins{}
	string %RuntimePlugins{"plProcGenPlugin"}
	string %PackageDependencies{}

	// ---- assets ---------------------------------------------------------------
	// Mounted as a data directory when the package is installed. The layout below Assets/
	// mirrors where this content sat inside the engine, so every shader include, shape icon
	// lookup and asset reference resolves exactly as it did before.
	Mount { string %Path{"Assets"} string %RootName{"plasma.procgen"} bool %Writable{false} }

	Component { string %Name{"assets"} string %Platform{"any"} }
	Component { string %Name{"manifest"} string %Platform{"any"} }
	Component { string %Name{"runtime-win64"} string %Platform{"win64"} }
	Component { string %Name{"runtime-linux64"} string %Platform{"linux64"} string %AbiTag{"linux64-clang18-0.12.0-abi7-dev"} }
	Component { string %Name{"runtime-macos64"} string %Platform{"macos64"} string %AbiTag{"macosarm64-clang17-0.12.0-abi7-dev"} }
	Component { string %Name{"editor-win64"} string %Platform{"win64"} }
	Component { string %Name{"icon"} string %Platform{"any"} }
	Component { string %Name{"banner"} string %Platform{"any"} }
	// The editor plugin's icons, found under their ids (":/AssetIcons/ProcGen_Graph.svg") in EditorIcons.
	Component { string %Name{"tool"} string %Platform{"any"} string %Path{"EditorIcons"} }
}
